# =============================================================================
# GestRisk AI WhatsApp — copie para .env e preencha os valores
#   copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# =============================================================================

# --- n8n ---
# Chave de criptografia das credenciais (mín. 32 caracteres; não altere após uso em produção)
N8N_ENCRYPTION_KEY=substitua_por_string_longa_aleatoria_minimo_32_chars

# n8n 2.x: já definido no docker-compose — permite $env nos nós (Gemini/Supabase)
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# URL pública usada pelo n8n em links/webhooks quando acessado de fora do Docker
# Ex.: https://n8n.seudominio.com/ atrás de reverse proxy com TLS
N8N_WEBHOOK_URL=http://localhost:5678/

# Opcional: proteger a interface do n8n
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# Fuso horário dos workflows
TZ=America/Sao_Paulo

# --- WAHA ---
# true = Dashboard funciona sem colar API key (apenas rede local). false = defina WAHA_API_KEY forte.
WAHA_NO_API_KEY=true
WAHA_API_KEY=
# WAHA Core: use sempre default. WAHA Plus pode usar outro nome (ex.: número da linha).
WAHA_SESSION_NAME=default
# Linha WhatsApp alvo (chatId em API: ${GESTRISK_WHATSAPP_LINE}@c.us)
GESTRISK_WHATSAPP_LINE=5521920472118

# --- WAHA (segurança — use valores fortes em produção) ---
# Se WAHA_NO_API_KEY=false, preencha:
# WAHA_API_KEY=substitua_por_chave_api_longa_aleatoria
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=substitua_por_senha_forte
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=substitua_por_senha_forte

WAHA_DASHBOARD_ENABLED=true
WHATSAPP_SWAGGER_ENABLED=true

# Engine: WEBJS (padrão), NOWEB ou GOWS conforme documentação WAHA
WHATSAPP_DEFAULT_ENGINE=WEBJS

# Base URL pública do WAHA (mídia em webhooks)
WAHA_BASE_URL=http://localhost:3000

# Webhook interno Docker → n8n (path do nó Webhook do fluxo GestRisk)
WHATSAPP_HOOK_URL=http://n8n:5678/webhook/gestrisk-whatsapp
# Eventos: não use message.any junto com message (mesma mensagem = 2 POSTs). session.status = QR/sessão
WHATSAPP_HOOK_EVENTS=message,session.status

# Cabeçalhos extras no POST do webhook (ex.: token para o n8n validar)
# WHATSAPP_HOOK_CUSTOM_HEADERS=X-GestRisk-Token:seu_token_secreto

WAHA_PRINT_QR=false

# --- GestRisk workflow (n8n: Gemini + Supabase) ---
# Gemini: https://aistudio.google.com/apikey
# Supabase: Project Settings → API (URL + service_role). Rode supabase/migrations/003_gestrisk_sessoes.sql
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GESTRISK_DEFAULT_GESTANTE_ID=GEST-001

# --- Laravel API (histórico em gestante_whatsapp; ver docs/API-LARAVEL-HISTORICO-WHATSAPP-N8N-WAHA.md) ---
# Base URL sem barra final. Com n8n no Docker e Laravel no PC: host.docker.internal (Windows/Mac) ou IP da máquina.
LARAVEL_APP_URL=http://host.docker.internal:8000
# Opcional: mesmo valor de WAHA_WEBHOOK_SECRET no .env do Laravel (header X-Webhook-Secret nas chamadas do fluxo)
WAHA_WEBHOOK_SECRET=
